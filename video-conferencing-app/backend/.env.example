# Copy this file to .env and fill in your real values.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Port the backend server listens on
PORT=8000

# Allowed frontend origin for CORS (Express + Socket.IO)
CLIENT_ORIGIN=http://localhost:3000

# Secret used to sign JWT auth tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_string

# OpenRouter API key for the AI meeting summarizer (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
